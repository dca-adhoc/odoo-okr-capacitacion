<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category for Apps/Settings Grouping -->
    <record id="module_category_okr" model="ir.module.category">
        <field name="name">OKR Management</field>
        <field name="description">Helps manage OKRs, Objectives, and Key Results hierarchy.</field>
        <field name="sequence">10</field>
    </record>

    <!-- Security Groups -->
    <record id="group_okr_user" model="res.groups">
        <field name="name">User</field>
    </record>

    <record id="group_okr_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_okr_user'))]"/>
    </record>

    <!-- Record Rules: OKR Management -->
    <record id="rule_okr_management_user_write" model="ir.rule">
        <field name="name">OKR User: Write own management records</field>
        <field name="model_id" ref="model_okr_management"/>
        <field name="domain_force">[('responsible_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_okr_management_manager_all" model="ir.rule">
        <field name="name">OKR Manager: Full access to management records</field>
        <field name="model_id" ref="model_okr_management"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_okr_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Record Rules: OKR Objective -->
    <record id="rule_okr_objective_user_write" model="ir.rule">
        <field name="name">OKR Objective User: Write own objectives</field>
        <field name="model_id" ref="model_okr_objective"/>
        <field name="domain_force">[('responsible_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_okr_objective_manager_all" model="ir.rule">
        <field name="name">OKR Objective Manager: Full access to objectives</field>
        <field name="model_id" ref="model_okr_objective"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_okr_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Record Rules: OKR Key Result -->
    <record id="rule_okr_key_result_user_write" model="ir.rule">
        <field name="name">OKR Key Result User: Write own key results</field>
        <field name="model_id" ref="model_okr_key_result"/>
        <field name="domain_force">[('responsible_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_okr_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_okr_key_result_manager_all" model="ir.rule">
        <field name="name">OKR Key Result Manager: Full access to key results</field>
        <field name="model_id" ref="model_okr_key_result"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_okr_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
